page {
  --ink: #202923;
  --muted: #66736b;
  --paper: #f5f7f5;
  --card: rgba(255, 255, 255, 0.97);
  --accent: #246447;
  --accent-dark: #1f5a3f;
  --green: #246447;
  color: var(--ink);
  background: var(--paper);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  font: inherit;
}

button::after {
  border: 0;
}

.safe-top {
  height: env(safe-area-inset-top);
}
