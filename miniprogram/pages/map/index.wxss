.page-shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #e8e5dc;
}

.map {
  width: 100%;
  height: 100%;
}

.top-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 0 28rpx 22rpx;
  background: linear-gradient(180deg, rgba(247, 244, 237, 0.99) 0%, rgba(247, 244, 237, 0.94) 76%, rgba(247, 244, 237, 0) 100%);
  pointer-events: none;
}

.title-row,
.category-scroll,
.filter-row {
  pointer-events: auto;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 118rpx;
}

.eyebrow {
  color: #88887d;
  font-size: 21rpx;
  letter-spacing: 4rpx;
  margin-bottom: 3rpx;
}

.title {
  font-size: 43rpx;
  line-height: 1.1;
  font-weight: 760;
  letter-spacing: -1rpx;
}

.round-button {
  margin: 0;
  padding: 0;
  min-width: 72rpx;
  width: 72rpx;
  height: 72rpx;
  line-height: 66rpx;
  border-radius: 50%;
  background: rgba(255, 253, 247, 0.95);
  color: #2e3029;
  box-shadow: 0 8rpx 28rpx rgba(45, 44, 36, 0.12);
}

.menu-button {
  font-weight: 700;
  letter-spacing: 2rpx;
}

.category-scroll {
  width: 100%;
  white-space: nowrap;
}

.chip-row,
.nearby-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 26rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  flex: none;
  margin: 0;
  min-height: 66rpx;
  padding: 0 22rpx;
  border-radius: 33rpx;
  background: rgba(255, 253, 247, 0.95);
  color: #4f5049;
  font-size: 25rpx;
  box-shadow: 0 5rpx 18rpx rgba(45, 44, 36, 0.08);
}

.category-chip.active {
  background: #24251f;
  color: #fffdf7;
}

.chip-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 5rpx;
  border-radius: 15rpx;
  background: rgba(100, 100, 90, 0.12);
  font-size: 19rpx;
}

.category-chip.active .chip-count {
  background: rgba(255, 255, 255, 0.18);
}

.add-chip {
  color: #785616;
  border: 1rpx dashed rgba(120, 86, 22, 0.38);
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
}

.status-chip {
  margin: 0;
  padding: 0 17rpx;
  height: 51rpx;
  line-height: 51rpx;
  border-radius: 25rpx;
  background: rgba(255, 253, 247, 0.84);
  color: #77786e;
  font-size: 22rpx;
}

.status-chip.active {
  color: #785616;
  background: #f8d58d;
  font-weight: 650;
}

.count-label {
  margin-left: auto;
  color: #6d6e65;
  font-size: 21rpx;
  white-space: nowrap;
}

.map-actions {
  position: absolute;
  right: 22rpx;
  top: 330rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  margin: 0;
  padding: 7rpx;
  width: 90rpx;
  min-height: 86rpx;
  border-radius: 22rpx;
  background: rgba(255, 253, 247, 0.96);
  color: #55564e;
  font-size: 19rpx;
  line-height: 1.2;
  box-shadow: 0 8rpx 28rpx rgba(45, 44, 36, 0.15);
}

.map-action-icon {
  color: #24251f;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-state {
  position: absolute;
  left: 50%;
  top: 47%;
  transform: translate(-50%, -50%);
  width: 500rpx;
  padding: 38rpx 34rpx;
  box-sizing: border-box;
  border-radius: 30rpx;
  background: rgba(255, 253, 247, 0.95);
  text-align: center;
  box-shadow: 0 18rpx 60rpx rgba(45, 44, 36, 0.17);
}

.empty-icon {
  font-size: 58rpx;
  margin-bottom: 12rpx;
}

.empty-title {
  font-size: 31rpx;
  font-weight: 700;
}

.empty-copy {
  color: #77786e;
  margin: 10rpx 0 24rpx;
  font-size: 24rpx;
}

.empty-action {
  width: 100%;
  margin: 0;
  border-radius: 24rpx;
  background: #24251f;
  color: white;
  font-size: 25rpx;
}

.bottom-stack {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
}

.selected-card,
.nearby-panel {
  border-radius: 28rpx;
  background: rgba(255, 253, 247, 0.97);
  box-shadow: 0 16rpx 58rpx rgba(45, 44, 36, 0.18);
}

.selected-card {
  margin-bottom: 13rpx;
  padding: 24rpx;
}

.selected-head,
.nearby-head,
.nearby-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.selected-category {
  color: #6c6d64;
  font-size: 22rpx;
}

.close-button {
  margin: -12rpx -10rpx 0 0;
  padding: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  border-radius: 50%;
  background: transparent;
  color: #85867d;
  font-size: 37rpx;
}

.selected-name {
  width: 90%;
  margin-top: 4rpx;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 750;
}

.selected-address {
  margin-top: 8rpx;
  color: #77786e;
  font-size: 23rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-meta {
  margin-top: 10rpx;
  color: #4e6b5d;
  font-size: 22rpx;
}

.dot {
  margin: 0 8rpx;
  color: #a7a89f;
}

.selected-actions {
  display: flex;
  gap: 9rpx;
  margin-top: 19rpx;
}

.selected-actions button {
  flex: 1;
  margin: 0;
  padding: 0 12rpx;
  height: 65rpx;
  line-height: 65rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  white-space: nowrap;
}

.secondary-action {
  background: #eeece5;
  color: #45463f;
}

.primary-action {
  background: #24251f;
  color: #fff;
  font-weight: 650;
}

.nearby-panel {
  padding: 18rpx 18rpx 17rpx;
}

.nearby-head {
  padding: 0 4rpx 11rpx;
}

.nearby-title {
  font-size: 26rpx;
  font-weight: 700;
}

.nearby-tip {
  margin-left: 13rpx;
  color: #92938a;
  font-size: 19rpx;
}

.collapse-button {
  margin: 0;
  padding: 0 10rpx;
  height: 43rpx;
  line-height: 43rpx;
  background: transparent;
  color: #77786e;
  font-size: 21rpx;
}

.nearby-scroll {
  width: 100%;
  white-space: nowrap;
}

.nearby-card {
  box-sizing: border-box;
  width: 230rpx;
  height: 142rpx;
  padding: 15rpx 17rpx;
  border: 2rpx solid transparent;
  border-radius: 21rpx;
  background: #f1efe8;
}

.nearby-card.selected {
  border-color: #24251f;
  background: #fffaf0;
}

.nearby-emoji {
  font-size: 28rpx;
}

.nearby-distance {
  color: #5d7568;
  font-size: 19rpx;
}

.nearby-name {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.25;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-status {
  margin-top: 5rpx;
  color: #8a8b82;
  font-size: 19rpx;
}

.add-button {
  position: absolute;
  right: 27rpx;
  bottom: calc(234rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 0;
  padding: 0 24rpx;
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 39rpx;
  background: #f4b83f;
  color: #302306;
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 36rpx rgba(88, 62, 11, 0.24);
}

.plus {
  font-size: 37rpx;
  font-weight: 400;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 23, 20, 0.45);
}

.modal-card {
  box-sizing: border-box;
  width: 600rpx;
  padding: 35rpx;
  border-radius: 32rpx;
  background: #fffdf7;
  box-shadow: 0 30rpx 100rpx rgba(0, 0, 0, 0.22);
}

.modal-title {
  font-size: 34rpx;
  font-weight: 750;
}

.modal-copy {
  margin-top: 6rpx;
  color: #85867d;
  font-size: 23rpx;
}

.category-input {
  box-sizing: border-box;
  width: 100%;
  height: 90rpx;
  margin-top: 27rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #f0eee7;
  font-size: 29rpx;
}

.modal-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 27rpx;
}

.modal-actions button {
  flex: 1;
  margin: 0;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.modal-cancel {
  background: #efede6;
  color: #606159;
}

.modal-confirm {
  background: #24251f;
  color: #fff;
}
