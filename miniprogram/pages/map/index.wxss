.page-shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #e7ece8;
}

.map {
  width: 100%;
  height: 100%;
}

.top-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 0 24rpx;
  pointer-events: none;
}

.top-toolbar,
.category-scroll {
  pointer-events: auto;
}

.top-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 16rpx 0 24rpx;
  border: 1rpx solid rgba(32, 41, 35, 0.06);
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 8rpx 30rpx rgba(20, 45, 29, 0.09);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 9rpx;
  flex: none;
}

.title {
  color: #202923;
  font-size: 29rpx;
  font-weight: 650;
  white-space: nowrap;
}

.result-count {
  min-width: 30rpx;
  color: #78837c;
  font-size: 19rpx;
}

.status-control {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: #f0f4f1;
}

.status-option {
  flex: 1;
  min-width: 0;
  height: 48rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: transparent;
  color: #6c7870;
  font-size: 20rpx;
  line-height: 48rpx;
  white-space: nowrap;
}

.status-option.active {
  background: #246447;
  color: #fff;
  font-weight: 650;
}

.category-scroll {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
  padding-top: 12rpx;
  white-space: nowrap;
}

.category-row,
.nearby-list {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.category-row {
  padding: 0 24rpx 8rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  flex: none;
  height: 58rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(32, 41, 35, 0.07);
  border-radius: 29rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #59655d;
  font-size: 22rpx;
  line-height: 58rpx;
}

.category-chip.active {
  border-color: #246447;
  background: #eaf3ed;
  color: #1f5a3f;
  font-weight: 650;
}

.category-chip-icon {
  width: 27rpx;
  height: 27rpx;
}

.map-actions {
  position: absolute;
  right: 24rpx;
  top: 236rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-action {
  width: 76rpx;
  min-width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(32, 41, 35, 0.07);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.97);
  color: #246447;
  font-size: 35rpx;
  line-height: 76rpx;
  box-shadow: 0 8rpx 30rpx rgba(20, 45, 29, 0.10);
}

.map-action-small {
  font-size: 23rpx;
  font-weight: 650;
}

.empty-state {
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  width: 520rpx;
  color: #202923;
  text-align: center;
  pointer-events: none;
}

.empty-icon {
  font-size: 52rpx;
  margin-bottom: 13rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 650;
}

.empty-copy {
  margin-top: 9rpx;
  color: #66736b;
  font-size: 23rpx;
  line-height: 1.5;
}

.bottom-stack {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
}

.quick-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.add-button {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: auto;
  height: 72rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #246447;
  color: #fff;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 72rpx;
  box-shadow: 0 8rpx 30rpx rgba(20, 68, 43, 0.22);
}

.plus {
  font-size: 31rpx;
  font-weight: 400;
}

.selected-card {
  box-sizing: border-box;
  padding: 25rpx;
  border: 1rpx solid rgba(32, 41, 35, 0.07);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 10rpx 38rpx rgba(20, 45, 29, 0.12);
}

.selected-head,
.selected-tags,
.nearby-head,
.nearby-card-head {
  display: flex;
  align-items: center;
}

.selected-head,
.nearby-head,
.nearby-card-head {
  justify-content: space-between;
}

.selected-tags {
  gap: 13rpx;
}

.category-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 21rpx;
  background: #eaf3ed;
}

.category-mark image {
  width: 37rpx;
  height: 37rpx;
}

.selected-category {
  color: #66736b;
  font-size: 20rpx;
}

.lifecycle-label {
  margin-top: 2rpx;
  color: #246447;
  font-size: 21rpx;
  font-weight: 650;
}

.lifecycle-label.visited {
  color: #59655d;
}

.close-button {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: -8rpx -8rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #7b867f;
  font-size: 38rpx;
  line-height: 60rpx;
}

.selected-name {
  margin-top: 17rpx;
  color: #202923;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 650;
}

.selected-meta {
  margin-top: 9rpx;
  color: #246447;
  font-size: 21rpx;
}

.dot {
  margin: 0 8rpx;
  color: #a2aba5;
}

.selected-address {
  margin-top: 8rpx;
  color: #758078;
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-note {
  display: -webkit-box;
  margin-top: 15rpx;
  padding: 15rpx 17rpx;
  border-radius: 17rpx;
  background: #f0f5f1;
  color: #46534b;
  font-size: 23rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.selected-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.selected-actions button {
  flex: 1;
  height: 68rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 68rpx;
  white-space: nowrap;
}

.quiet-action {
  flex: 0 0 108rpx !important;
  background: #f1f3f1;
  color: #66736b;
}

.secondary-action {
  background: #eaf3ed;
  color: #246447;
  font-weight: 650;
}

.primary-action {
  background: #246447;
  color: #fff;
  font-weight: 650;
}

.nearby-panel {
  padding: 0;
}

.nearby-head {
  min-height: 54rpx;
  padding: 0 8rpx 9rpx;
  color: #202923;
}

.nearby-title {
  font-size: 24rpx;
  font-weight: 650;
}

.nearby-tip {
  margin-left: 12rpx;
  color: #6f7a73;
  font-size: 19rpx;
}

.collapse-button {
  width: auto;
  min-width: 88rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 14rpx;
  background: transparent;
  color: #536158;
  font-size: 20rpx;
  line-height: 54rpx;
}

.nearby-scroll {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
  white-space: nowrap;
}

.nearby-list {
  padding: 0 24rpx 3rpx;
}

.nearby-card {
  box-sizing: border-box;
  width: 330rpx;
  height: 154rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(32, 41, 35, 0.07);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 7rpx 24rpx rgba(20, 45, 29, 0.10);
}

.nearby-category,
.nearby-distance {
  color: #66736b;
  font-size: 18rpx;
}

.nearby-category {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.nearby-category image {
  width: 24rpx;
  height: 24rpx;
}

.nearby-distance {
  color: #246447;
}

.nearby-name {
  margin-top: 9rpx;
  color: #202923;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 650;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-note {
  margin-top: 7rpx;
  color: #59655d;
  font-size: 19rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-note.muted {
  color: #879189;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(22, 28, 24, 0.38);
}

.modal-card {
  box-sizing: border-box;
  width: 600rpx;
  padding: 34rpx;
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 24rpx 80rpx rgba(20, 45, 29, 0.20);
}

.modal-title {
  color: #202923;
  font-size: 32rpx;
  font-weight: 650;
}

.modal-copy {
  margin-top: 7rpx;
  color: #758078;
  font-size: 22rpx;
}

.category-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 26rpx;
  padding: 0 21rpx;
  border-radius: 18rpx;
  background: #f1f4f2;
  color: #202923;
  font-size: 27rpx;
}

.icon-picker-label {
  margin-top: 24rpx;
  color: #46534b;
  font-size: 22rpx;
  font-weight: 650;
}

.icon-picker-scroll {
  height: 300rpx;
  margin-top: 14rpx;
}

.icon-picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 2rpx;
}

.icon-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
  height: 91rpx;
  margin: 0;
  padding: 7rpx;
  border: 2rpx solid transparent;
  border-radius: 17rpx;
  background: #f1f4f2;
  color: #66736b;
  font-size: 18rpx;
  line-height: 1.1;
}

.icon-option.active {
  border-color: #246447;
  background: #eaf3ed;
  color: #1f5a3f;
}

.icon-option image {
  width: 34rpx;
  height: 34rpx;
}

.modal-actions {
  display: flex;
  gap: 13rpx;
  margin-top: 25rpx;
}

.modal-actions button {
  flex: 1;
  height: 72rpx;
  margin: 0;
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 72rpx;
}

.modal-cancel {
  background: #f1f3f1;
  color: #66736b;
}

.modal-confirm {
  background: #246447;
  color: #fff;
}
