.page-shell {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background: #f2f2f7;
}

.map {
  width: 100%;
  height: 100%;
}

.top-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 0 24rpx;
  pointer-events: none;
}

.top-toolbar,
.category-scroll {
  pointer-events: auto;
}

.top-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
  height: 88rpx;
  padding: 0 16rpx 0 24rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.10);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 9rpx;
  flex: none;
}

.title {
  color: #1c1c1e;
  font-size: 29rpx;
  font-weight: 600;
  white-space: nowrap;
}

.result-count {
  min-width: 30rpx;
  color: #8e8e93;
  font-size: 19rpx;
}

.status-control {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: #e9e9eb;
}

.status-option {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  margin: 0;
  padding: 0 8rpx;
  border-radius: 15rpx;
  background: transparent;
  color: #6c6c70;
  font-size: 20rpx;
  line-height: 64rpx;
  white-space: nowrap;
}

.status-option.active {
  background: #fff;
  color: #1c1c1e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.category-scroll {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
  padding-top: 12rpx;
  white-space: nowrap;
}

.category-row,
.nearby-list {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

.category-row {
  padding: 0 24rpx 8rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 7rpx;
  flex: none;
  min-height: 72rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.07);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #3c3c43;
  font-size: 22rpx;
  line-height: 72rpx;
}

.category-chip.active {
  font-weight: 600;
}

.category-chip-icon {
  width: 27rpx;
  height: 27rpx;
}

.category-chip-text-icon {
  min-width: 27rpx;
  font-size: 21rpx;
  font-weight: 700;
  line-height: 27rpx;
  text-align: center;
}

.manage-chip {
  border-style: dashed;
  color: #007aff;
}

.manage-symbol {
  position: relative;
  top: -3rpx;
  letter-spacing: 1rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.placement-banner {
  position: absolute;
  left: 50%;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 22rpx;
  transform: translateX(-50%);
  box-sizing: border-box;
  min-width: 390rpx;
  padding: 17rpx 17rpx 17rpx 24rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.14);
}

.placement-title {
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
}

.placement-copy {
  margin-top: 3rpx;
  color: #8e8e93;
  font-size: 20rpx;
  white-space: nowrap;
}

.placement-cancel {
  width: auto;
  min-width: 88rpx;
  height: 64rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 15rpx;
  background: #f2f2f7;
  color: #007aff;
  font-size: 22rpx;
  line-height: 64rpx;
}

.map-actions {
  position: absolute;
  right: 24rpx;
  top: 236rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-action {
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(60, 60, 67, 0.07);
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.97);
  color: #007aff;
  font-size: 35rpx;
  line-height: 88rpx;
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.12);
}

.map-action-small {
  font-size: 23rpx;
  font-weight: 600;
}

.empty-state {
  position: absolute;
  left: 50%;
  top: 48%;
  transform: translate(-50%, -50%);
  width: 520rpx;
  color: #1c1c1e;
  text-align: center;
  pointer-events: none;
}

.empty-icon {
  font-size: 52rpx;
  margin-bottom: 13rpx;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 600;
}

.empty-copy {
  margin-top: 9rpx;
  color: #6c6c70;
  font-size: 23rpx;
  line-height: 1.5;
}

.bottom-stack {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
}

.quick-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 12rpx;
}

.add-button {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: auto;
  height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #007aff;
  color: #fff;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 88rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.22);
}

.plus {
  font-size: 31rpx;
  font-weight: 400;
}

.selected-card {
  box-sizing: border-box;
  padding: 25rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.07);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.14);
}

.selected-head,
.selected-tags,
.nearby-head,
.nearby-card-head {
  display: flex;
  align-items: center;
}

.selected-head,
.nearby-head,
.nearby-card-head {
  justify-content: space-between;
}

.selected-tags {
  gap: 13rpx;
}

.category-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border-radius: 21rpx;
  background: #eaf3ff;
}

.category-mark image {
  width: 37rpx;
  height: 37rpx;
}

.category-symbol-text {
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.selected-category {
  color: #6c6c70;
  font-size: 20rpx;
}

.lifecycle-label {
  margin-top: 2rpx;
  color: #3c3c43;
  font-size: 21rpx;
  font-weight: 600;
}

.lifecycle-label.visited {
  color: #3c3c43;
}

.close-button {
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: -8rpx -8rpx 0 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  color: #8e8e93;
  font-size: 38rpx;
  line-height: 84rpx;
}

.selected-name {
  margin-top: 17rpx;
  color: #1c1c1e;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: 600;
}

.selected-meta {
  margin-top: 9rpx;
  color: #6c6c70;
  font-size: 21rpx;
}

.dot {
  margin: 0 8rpx;
  color: #c7c7cc;
}

.selected-address {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 21rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-note {
  display: -webkit-box;
  margin-top: 15rpx;
  padding: 15rpx 17rpx;
  border-radius: 17rpx;
  background: #f2f2f7;
  color: #3c3c43;
  font-size: 23rpx;
  line-height: 1.45;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.selected-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 20rpx;
}

.selected-actions button {
  flex: 1;
  height: 80rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  line-height: 80rpx;
  white-space: nowrap;
}

.quiet-action {
  flex: 0 0 108rpx !important;
  background: #f2f2f7;
  color: #6c6c70;
}

.secondary-action {
  background: #eaf3ff;
  color: #007aff;
  font-weight: 600;
}

.primary-action {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

.nearby-panel {
  padding: 0;
}

.nearby-head {
  min-height: 54rpx;
  padding: 0 8rpx 9rpx;
  color: #1c1c1e;
}

.nearby-title {
  font-size: 24rpx;
  font-weight: 600;
}

.nearby-tip {
  margin-left: 12rpx;
  color: #8e8e93;
  font-size: 19rpx;
}

.collapse-button {
  width: auto;
  min-width: 88rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 14rpx;
  background: transparent;
  color: #6c6c70;
  font-size: 20rpx;
  line-height: 72rpx;
}

.nearby-scroll {
  width: calc(100% + 48rpx);
  margin-left: -24rpx;
  white-space: nowrap;
}

.nearby-list {
  padding: 0 24rpx 3rpx;
}

.nearby-card {
  box-sizing: border-box;
  width: 330rpx;
  height: 154rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.07);
  border-radius: 25rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 5rpx 20rpx rgba(0, 0, 0, 0.10);
}

.nearby-category,
.nearby-distance {
  color: #6c6c70;
  font-size: 18rpx;
}

.nearby-category {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.nearby-category image {
  width: 24rpx;
  height: 24rpx;
}

.nearby-category .category-symbol-text {
  min-width: 24rpx;
  font-size: 18rpx;
}

.nearby-distance {
  color: #6c6c70;
}

.nearby-name {
  margin-top: 9rpx;
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 1.2;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-note {
  margin-top: 7rpx;
  color: #3c3c43;
  font-size: 19rpx;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-note.muted {
  color: #8e8e93;
}

.modal-mask {
  position: fixed;
  z-index: 20;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.32);
}

.modal-card {
  box-sizing: border-box;
  width: 100%;
  padding: 14rpx 34rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
  box-shadow: 0 -8rpx 36rpx rgba(0, 0, 0, 0.16);
}

.sheet-handle {
  width: 72rpx;
  height: 10rpx;
  margin: 0 auto 7rpx;
  border-radius: 5rpx;
  background: #d1d1d6;
}

.sheet-toolbar {
  display: grid;
  grid-template-columns: 120rpx 1fr 120rpx;
  align-items: center;
  min-height: 80rpx;
}

.sheet-button {
  width: 120rpx;
  height: 80rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: #007aff;
  font-size: 25rpx;
  line-height: 80rpx;
  text-align: left;
}

.sheet-button.done {
  font-weight: 600;
  text-align: right;
}

.sheet-button[disabled] {
  color: #aeaeb2;
}

.modal-title {
  color: #1c1c1e;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
}

.modal-copy {
  margin-top: 7rpx;
  color: #8e8e93;
  font-size: 22rpx;
}

.category-manager-scroll {
  max-height: 600rpx;
  margin-top: 22rpx;
  border-radius: 20rpx;
  background: #f2f2f7;
}

.category-manager-row {
  position: relative;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 112rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.category-manager-row + .category-manager-row::before {
  content: "";
  position: absolute;
  top: 0;
  left: 92rpx;
  right: 0;
  height: 1rpx;
  background: rgba(60, 60, 67, 0.12);
}

.manager-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
}

.manager-icon image {
  width: 36rpx;
  height: 36rpx;
}

.manager-icon .category-symbol-text {
  font-size: 26rpx;
}

.manager-copy {
  flex: 1;
  min-width: 0;
  margin-left: 17rpx;
}

.manager-name {
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 1.25;
}

.manager-count {
  margin-top: 4rpx;
  color: #8e8e93;
  font-size: 20rpx;
  line-height: 1.2;
}

.manager-chevron {
  margin-left: 14rpx;
  color: #c7c7cc;
  font-size: 43rpx;
  font-weight: 300;
}

.category-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 26rpx;
  padding: 0 21rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 27rpx;
}

.category-editor-scroll {
  height: 650rpx;
  max-height: calc(86vh - 120rpx);
}

.color-picker-row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.color-option {
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 5rpx solid #fff;
  border-radius: 50%;
  color: #fff;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 54rpx;
  box-shadow: 0 0 0 2rpx transparent;
}

.color-option.active {
  box-shadow: 0 0 0 3rpx #8e8e93;
}

.icon-picker-label {
  margin-top: 24rpx;
  color: #3c3c43;
  font-size: 22rpx;
  font-weight: 600;
}

.icon-picker-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  padding: 2rpx;
}

.editor-icon-grid {
  margin-top: 14rpx;
}

.text-symbol-sample {
  color: #007aff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.symbol-text-editor {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f2f2f7;
}

.symbol-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid;
  border-radius: 50%;
  background: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.symbol-text-copy {
  flex: 1;
  min-width: 0;
}

.symbol-text-input {
  height: 48rpx;
  color: #1c1c1e;
  font-size: 25rpx;
  font-weight: 600;
}

.symbol-text-help {
  color: #8e8e93;
  font-size: 18rpx;
  line-height: 1.35;
}

.editor-scroll-spacer {
  height: 22rpx;
}

.icon-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-sizing: border-box;
  height: 96rpx;
  margin: 0;
  padding: 7rpx;
  border: 2rpx solid transparent;
  border-radius: 17rpx;
  background: #f2f2f7;
  color: #6c6c70;
  font-size: 18rpx;
  line-height: 1.1;
}

.icon-option.active {
  border-color: #007aff;
  background: #eaf3ff;
  color: #1c1c1e;
}

.icon-option image {
  width: 34rpx;
  height: 34rpx;
}
