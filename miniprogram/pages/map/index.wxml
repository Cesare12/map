<view class="page-shell">
  <map
    id="mainMap"
    class="map"
    longitude="{{mapLongitude}}"
    latitude="{{mapLatitude}}"
    scale="{{mapScale}}"
    markers="{{markers}}"
    enable-rotate="{{false}}"
    enable-overlooking="{{false}}"
    max-scale="20"
    show-location="{{locationReady}}"
    bindtap="onMapTap"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  ></map>

  <view class="top-panel">
    <view class="safe-top" style="height: {{safeTop}}px"></view>
    <view class="top-toolbar" style="margin-right: {{capsuleReserve}}px">
      <view class="brand-block">
        <text class="title">我的地点</text>
        <text class="result-count">{{filteredPlaces.length}}</text>
      </view>
      <view class="status-control">
        <button
          wx:for="{{statusTabs}}"
          wx:key="id"
          class="status-option {{item.active ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectStatus"
        >{{item.name}}</button>
      </view>
    </view>

    <scroll-view class="category-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="category-row">
        <button
          wx:for="{{categoryTabs}}"
          wx:key="id"
          class="category-chip {{item.active ? 'active' : ''}}"
          style="{{item.style}}"
          data-id="{{item.id}}"
          bindtap="selectCategory"
        >
          <text class="category-chip-text-icon" style="color: {{item.color}}" wx:if="{{item.usesText}}">{{item.symbolText}}</text>
          <image class="category-chip-icon" src="{{item.iconPath}}" mode="aspectFit" wx:else />
          <text>{{item.name}}</text>
        </button>
        <button class="category-chip manage-chip" bindtap="showCategoryManager" aria-label="管理分类">
          <text class="manage-symbol">•••</text>
          <text>管理</text>
        </button>
      </view>
    </scroll-view>
  </view>

  <view class="placement-banner" wx:if="{{manualPinMode}}" style="top: {{mapActionsTop}}px">
    <view>
      <view class="placement-title">在地图上选择位置</view>
      <view class="placement-copy">轻点店铺所在位置</view>
    </view>
    <button class="placement-cancel" bindtap="cancelManualPin">取消</button>
  </view>

  <view class="map-actions" wx:if="{{!manualPinMode}}" style="top: {{mapActionsTop}}px">
    <button class="map-action" bindtap="moveToMyLocation" aria-label="回到我的位置">⌖</button>
    <button class="map-action map-action-small" bindtap="showAllPlaces" wx:if="{{filteredPlaces.length}}" aria-label="查看全部地点">全</button>
    <button class="map-action map-action-small" bindtap="openMore" aria-label="更多操作">•••</button>
  </view>

  <view class="empty-state" wx:if="{{!manualPinMode && emptyTitle}}">
    <view class="empty-icon">{{emptyIcon}}</view>
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-copy">{{emptyCopy}}</view>
  </view>

  <view class="bottom-stack" wx:if="{{!manualPinMode}}">
    <view class="quick-row" wx:if="{{!selectedPlace}}">
      <button class="add-button" bindtap="addPlace"><text class="plus">＋</text><text>添加地点</text></button>
    </view>

    <view class="selected-card" wx:if="{{selectedPlace}}">
      <view class="selected-head">
        <view class="selected-tags">
          <view class="category-mark" style="background: {{selectedPlace.categorySoftColor}}; color: {{selectedPlace.categoryColor}}">
            <text class="category-symbol-text" wx:if="{{selectedPlace.categoryUsesText}}">{{selectedPlace.categorySymbolText}}</text>
            <image src="{{selectedPlace.categoryIconPath}}" mode="aspectFit" wx:else />
          </view>
          <view>
            <view class="selected-category" style="color: {{selectedPlace.categoryColor}}">{{selectedPlace.categoryName}}</view>
            <view class="lifecycle-label {{selectedPlace.lifecycleClass}}">{{selectedPlace.lifecycleIcon}} {{selectedPlace.lifecycleLabel}}</view>
          </view>
        </view>
        <button class="close-button" bindtap="closeSelected">×</button>
      </view>
      <view class="selected-name">{{selectedPlace.name}}</view>
      <view class="selected-meta">
        <text>{{selectedPlace.distanceLabel}}</text>
        <text class="dot">·</text>
        <text>{{selectedPlace.statusLabel}}</text>
        <text wx:if="{{selectedPlace.latestVisitLabel}}" class="dot">·</text>
        <text wx:if="{{selectedPlace.latestVisitLabel}}">{{selectedPlace.latestVisitLabel}}</text>
      </view>
      <view class="selected-address">{{selectedPlace.address || '未填写地址'}}</view>
      <view class="selected-note" wx:if="{{selectedPlace.note}}">“{{selectedPlace.note}}”</view>
      <view class="selected-actions">
        <button class="quiet-action" bindtap="editSelected">编辑</button>
        <button class="secondary-action" bindtap="recordSelectedVisit" wx:if="{{selectedPlace.wantToVisit}}">完成拔草</button>
        <button class="secondary-action" bindtap="wantAgain" wx:else>再次种草</button>
        <button class="primary-action" bindtap="navigateSelected">导航</button>
      </view>
    </view>

    <view class="nearby-panel" wx:elif="{{filteredPlaces.length}}">
      <view class="nearby-head">
        <view>
          <text class="nearby-title">{{locationReady ? '离我最近' : '已保存地点'}}</text>
          <text class="nearby-tip">{{viewportLabel}}</text>
        </view>
        <button class="collapse-button" bindtap="toggleNearby">{{nearbyCollapsed ? '展开' : '收起'}}</button>
      </view>
      <scroll-view class="nearby-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" wx:if="{{!nearbyCollapsed}}">
        <view class="nearby-list">
          <view
            wx:for="{{nearbyPlaces}}"
            wx:key="id"
            class="nearby-card"
            data-id="{{item.id}}"
            bindtap="selectPlaceCard"
          >
            <view class="nearby-card-head">
              <view class="nearby-category" style="color: {{item.categoryColor}}">
                <text class="category-symbol-text" wx:if="{{item.categoryUsesText}}">{{item.categorySymbolText}}</text>
                <image src="{{item.categoryIconPath}}" mode="aspectFit" wx:else />
                <text>{{item.categoryName}}</text>
              </view>
              <view class="nearby-distance">{{item.distanceLabel}}</view>
            </view>
            <view class="nearby-name">{{item.name}}</view>
            <view class="nearby-note" wx:if="{{item.note}}">{{item.note}}</view>
            <view class="nearby-note muted" wx:else>{{item.lifecycleLabel}} · {{item.statusLabel}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{clusterSheetVisible}}" bindtap="closeClusterSheet">
    <view class="modal-card" catchtap="stopEvent">
      <view class="sheet-handle"></view>
      <view class="sheet-toolbar">
        <button class="sheet-button" bindtap="closeClusterSheet">关闭</button>
        <view class="modal-title">{{clusterSheetPlaces.length}} 个地点</view>
        <button class="sheet-button" bindtap="zoomCluster" disabled="{{!clusterCanZoom}}">放大</button>
      </view>
      <scroll-view class="category-manager-scroll" scroll-y="{{true}}" enhanced="{{true}}">
        <button
          wx:for="{{clusterSheetPlaces}}"
          wx:key="id"
          class="category-manager-row"
          data-id="{{item.id}}"
          bindtap="selectClusterPlace"
        >
          <view class="manager-icon" style="background: {{item.categorySoftColor}}; color: {{item.categoryColor}}">
            <text class="category-symbol-text" wx:if="{{item.categoryUsesText}}">{{item.categorySymbolText}}</text>
            <image src="{{item.categoryIconPath}}" mode="aspectFit" wx:else />
          </view>
          <view class="manager-copy">
            <view class="manager-name">{{item.name}}</view>
            <view class="manager-count">{{item.categoryName}} · {{item.lifecycleLabel}} · {{item.distanceLabel}}</view>
          </view>
          <text class="manager-chevron">›</text>
        </button>
      </scroll-view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{categoryCreatorVisible}}" bindtap="hideCategoryCreator">
    <view class="modal-card" catchtap="stopEvent">
      <view class="sheet-handle"></view>
      <view class="sheet-toolbar">
        <button class="sheet-button" bindtap="categorySheetBack">{{categoryEditorMode == 'manage' ? '取消' : '返回'}}</button>
        <view class="modal-title">{{categoryEditorMode == 'manage' ? '管理分类' : (categoryEditorMode == 'create' ? '新建分类' : '编辑分类')}}</view>
        <button class="sheet-button done" bindtap="categorySheetPrimary">{{categoryEditorMode == 'manage' ? '新建' : '完成'}}</button>
      </view>
      <block wx:if="{{categoryEditorMode == 'manage'}}">
        <view class="modal-copy">点按分类即可修改名称、颜色和标记</view>
        <scroll-view class="category-manager-scroll" scroll-y="{{true}}" enhanced="{{true}}">
          <button
            wx:for="{{categoryManagerItems}}"
            wx:key="id"
            class="category-manager-row"
            data-id="{{item.id}}"
            bindtap="editCategoryFromManager"
          >
            <view class="manager-icon" style="background: {{item.softColor}}">
              <text class="category-symbol-text" style="color: {{item.color}}" wx:if="{{item.usesText}}">{{item.symbolText}}</text>
              <image src="{{item.iconPath}}" mode="aspectFit" wx:else />
            </view>
            <view class="manager-copy">
              <view class="manager-name">{{item.name}}</view>
              <view class="manager-count">{{item.countLabel}}</view>
            </view>
            <text class="manager-chevron">›</text>
          </button>
        </scroll-view>
      </block>
      <block wx:else>
        <scroll-view class="category-editor-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="category-form-row">
            <view class="category-form-label">名称</view>
            <input
              class="category-input"
              value="{{newCategoryName}}"
              maxlength="8"
              placeholder="分类名称"
              aria-label="分类名称"
              focus="{{categoryCreatorVisible && categoryEditorMode == 'create'}}"
              bindinput="onCategoryNameInput"
              bindconfirm="saveCategoryEditor"
            />
          </view>
          <view class="category-form-row">
            <view class="category-form-label">图标</view>
            <view class="icon-picker-grid">
              <button
                class="icon-option {{newCategorySymbolType == 'text' ? 'active' : ''}}"
                bindtap="selectCategoryTextMode"
                aria-label="文字标记，取分类名称首字"
              >
                <text class="text-symbol-sample" style="color: {{newCategoryColor}}">{{newCategorySymbolType == 'text' && newCategoryGlyph ? newCategoryGlyph : '字'}}</text>
              </button>
              <button
                wx:for="{{categoryIconOptions}}"
                wx:key="key"
                class="icon-option {{item.active ? 'active' : ''}}"
                data-key="{{item.key}}"
                bindtap="selectCategoryIcon"
                aria-label="{{item.name}}"
              >
                <image src="{{item.iconPath}}" mode="aspectFit" />
              </button>
            </view>
          </view>
          <view class="category-form-row">
            <view class="category-form-label">颜色</view>
            <view class="color-picker-row">
              <button
                wx:for="{{categoryColorOptions}}"
                wx:key="key"
                class="color-option {{item.active ? 'active' : ''}}"
                style="background: {{item.hex}}"
                data-key="{{item.key}}"
                bindtap="selectCategoryColor"
                aria-label="{{item.name}}"
              ><text wx:if="{{item.active}}">✓</text></button>
            </view>
          </view>
          <view class="editor-scroll-spacer"></view>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
