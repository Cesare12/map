<view class="page-shell">
  <map
    id="mainMap"
    class="map"
    longitude="{{mapLongitude}}"
    latitude="{{mapLatitude}}"
    scale="{{mapScale}}"
    markers="{{markers}}"
    show-location="{{locationReady}}"
    bindmarkertap="onMarkerTap"
    bindregionchange="onRegionChange"
  ></map>

  <view class="top-panel">
    <view class="safe-top" style="height: {{safeTop}}px"></view>
    <view class="top-toolbar" style="margin-right: {{capsuleReserve}}px">
      <view class="brand-block">
        <text class="title">想去地图</text>
        <text class="result-count">{{filteredPlaces.length}}</text>
      </view>
      <view class="status-control">
        <button
          wx:for="{{statusTabs}}"
          wx:key="id"
          class="status-option {{item.active ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectStatus"
        >{{item.name}}</button>
      </view>
    </view>

    <scroll-view class="category-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="category-row">
        <button
          wx:for="{{categoryTabs}}"
          wx:key="id"
          class="category-chip {{item.active ? 'active' : ''}}"
          data-id="{{item.id}}"
          bindtap="selectCategory"
        >
          <text class="category-chip-icon">{{item.emoji}}</text>
          <text>{{item.name}}</text>
        </button>
      </view>
    </scroll-view>
  </view>

  <view class="map-actions" style="top: {{mapActionsTop}}px">
    <button class="map-action" bindtap="moveToMyLocation" aria-label="回到我的位置">⌖</button>
    <button class="map-action map-action-small" bindtap="showAllPlaces" wx:if="{{filteredPlaces.length}}" aria-label="查看全部地点">全</button>
    <button class="map-action map-action-small" bindtap="openMore" aria-label="更多操作">•••</button>
  </view>

  <view class="empty-state" wx:if="{{emptyTitle}}">
    <view class="empty-icon">{{emptyIcon}}</view>
    <view class="empty-title">{{emptyTitle}}</view>
    <view class="empty-copy">{{emptyCopy}}</view>
  </view>

  <view class="bottom-stack">
    <view class="quick-row" wx:if="{{!selectedPlace}}">
      <button class="add-button" bindtap="addPlace"><text class="plus">＋</text><text>添加地点</text></button>
    </view>

    <view class="selected-card" wx:if="{{selectedPlace}}">
      <view class="selected-head">
        <view class="selected-tags">
          <view class="category-mark">{{selectedPlace.categoryEmoji}}</view>
          <view>
            <view class="selected-category">{{selectedPlace.categoryName}}</view>
            <view class="lifecycle-label {{selectedPlace.lifecycleClass}}">{{selectedPlace.lifecycleIcon}} {{selectedPlace.lifecycleLabel}}</view>
          </view>
        </view>
        <button class="close-button" bindtap="closeSelected">×</button>
      </view>
      <view class="selected-name">{{selectedPlace.name}}</view>
      <view class="selected-meta">
        <text>{{selectedPlace.distanceLabel}}</text>
        <text class="dot">·</text>
        <text>{{selectedPlace.statusLabel}}</text>
        <text wx:if="{{selectedPlace.latestVisitLabel}}" class="dot">·</text>
        <text wx:if="{{selectedPlace.latestVisitLabel}}">{{selectedPlace.latestVisitLabel}}</text>
      </view>
      <view class="selected-address">{{selectedPlace.address || '未填写地址'}}</view>
      <view class="selected-note" wx:if="{{selectedPlace.note}}">“{{selectedPlace.note}}”</view>
      <view class="selected-actions">
        <button class="quiet-action" bindtap="editSelected">编辑</button>
        <button class="secondary-action" bindtap="recordSelectedVisit" wx:if="{{selectedPlace.wantToVisit}}">完成拔草</button>
        <button class="secondary-action" bindtap="wantAgain" wx:else>再次种草</button>
        <button class="primary-action" bindtap="navigateSelected">导航</button>
      </view>
    </view>

    <view class="nearby-panel" wx:elif="{{filteredPlaces.length}}">
      <view class="nearby-head">
        <view>
          <text class="nearby-title">{{locationReady ? '离我最近' : '已保存地点'}}</text>
          <text class="nearby-tip">{{viewportLabel}}</text>
        </view>
        <button class="collapse-button" bindtap="toggleNearby">{{nearbyCollapsed ? '展开' : '收起'}}</button>
      </view>
      <scroll-view class="nearby-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" wx:if="{{!nearbyCollapsed}}">
        <view class="nearby-list">
          <view
            wx:for="{{nearbyPlaces}}"
            wx:key="id"
            class="nearby-card"
            data-id="{{item.id}}"
            bindtap="selectPlaceCard"
          >
            <view class="nearby-card-head">
              <view class="nearby-category">{{item.categoryEmoji}} {{item.categoryName}}</view>
              <view class="nearby-distance">{{item.distanceLabel}}</view>
            </view>
            <view class="nearby-name">{{item.name}}</view>
            <view class="nearby-note" wx:if="{{item.note}}">{{item.note}}</view>
            <view class="nearby-note muted" wx:else>{{item.lifecycleLabel}} · {{item.statusLabel}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{categoryCreatorVisible}}" bindtap="hideCategoryCreator">
    <view class="modal-card" catchtap="stopEvent">
      <view class="modal-title">新建分类</view>
      <view class="modal-copy">例如：咖啡、露营、修车</view>
      <input
        class="category-input"
        value="{{newCategoryName}}"
        maxlength="8"
        placeholder="输入分类名称"
        focus="{{categoryCreatorVisible}}"
        bindinput="onCategoryNameInput"
        bindconfirm="createCategory"
      />
      <view class="modal-actions">
        <button class="modal-cancel" bindtap="hideCategoryCreator">取消</button>
        <button class="modal-confirm" bindtap="createCategory">创建</button>
      </view>
    </view>
  </view>
</view>
