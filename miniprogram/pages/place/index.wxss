.editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f7f4ed;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 98rpx;
  padding: 0 24rpx;
}

.nav-button,
.nav-spacer {
  width: 72rpx;
}

.nav-button {
  margin: 0;
  padding: 0;
  height: 72rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #ebe8e0;
  color: #2d2e28;
  font-size: 54rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
}

.place-hero {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 18rpx 24rpx 30rpx;
  padding: 30rpx 26rpx;
  border-radius: 30rpx;
  background: #24251f;
  color: white;
  box-shadow: 0 16rpx 45rpx rgba(41, 41, 35, 0.18);
}

.hero-pin {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #f5b93f;
  font-size: 35rpx;
}

.hero-content {
  flex: 1;
  min-width: 0;
}

.name-input {
  height: 58rpx;
  color: white;
  font-size: 34rpx;
  font-weight: 720;
}

.name-input::placeholder {
  color: rgba(255, 255, 255, 0.55);
}

.address {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 22rpx;
  line-height: 1.5;
}

.reselect-button {
  flex: none;
  margin: 2rpx 0 0;
  padding: 0 18rpx;
  height: 53rpx;
  line-height: 53rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.12);
  color: white;
  font-size: 21rpx;
}

.section {
  margin: 0 24rpx 22rpx;
  padding: 29rpx 27rpx;
  border-radius: 27rpx;
  background: #fffdf7;
  box-shadow: 0 7rpx 28rpx rgba(54, 52, 43, 0.06);
}

.compact-section {
  padding-top: 25rpx;
  padding-bottom: 25rpx;
}

.section-label {
  margin-bottom: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.optional {
  margin-left: 8rpx;
  color: #a2a299;
  font-size: 21rpx;
  font-weight: 400;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.category-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin: 0;
  padding: 0 12rpx;
  height: 76rpx;
  border: 2rpx solid transparent;
  border-radius: 21rpx;
  background: #f0eee7;
  color: #55564e;
  font-size: 24rpx;
}

.category-option.active {
  border-color: #24251f;
  background: #fff8e7;
  color: #24251f;
  font-weight: 650;
}

.category-emoji {
  font-size: 29rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-title {
  font-size: 27rpx;
  font-weight: 700;
}

.switch-copy {
  margin-top: 7rpx;
  color: #8d8e85;
  font-size: 21rpx;
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 19rpx;
  border-radius: 19rpx;
  background: #f2f0e9;
  color: #30312b;
  font-size: 25rpx;
  line-height: 1.55;
}

.word-count {
  margin-top: 10rpx;
  color: #a0a198;
  text-align: right;
  font-size: 19rpx;
}

.save-area {
  margin: 34rpx 24rpx 0;
}

.save-button {
  width: 100%;
  height: 91rpx;
  line-height: 91rpx;
  border-radius: 25rpx;
  background: #f5b93f;
  color: #302306;
  font-size: 29rpx;
  font-weight: 750;
  box-shadow: 0 12rpx 34rpx rgba(113, 79, 12, 0.18);
}

.delete-button {
  margin-top: 20rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #a25349;
  font-size: 24rpx;
}
