.editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f7f5;
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 98rpx;
  padding: 0 24rpx;
}

.nav-button,
.nav-spacer {
  width: 72rpx;
}

.nav-button {
  margin: 0;
  padding: 0;
  height: 72rpx;
  line-height: 64rpx;
  border-radius: 50%;
  background: #e8eeea;
  color: #246447;
  font-size: 54rpx;
  font-weight: 300;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
}

.place-hero {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 12rpx 24rpx 22rpx;
  padding: 27rpx 25rpx;
  border: 1rpx solid #e3e9e4;
  border-radius: 26rpx;
  background: #fff;
  color: #202923;
}

.hero-pin {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #eaf3ed;
  font-size: 35rpx;
}

.hero-content {
  flex: 1;
  min-width: 0;
}

.name-input {
  height: 58rpx;
  color: #202923;
  font-size: 34rpx;
  font-weight: 720;
}

.name-input::placeholder {
  color: #9aa49d;
}

.address {
  margin-top: 6rpx;
  color: #758078;
  font-size: 22rpx;
  line-height: 1.5;
}

.reselect-button {
  flex: none;
  margin: 2rpx 0 0;
  padding: 0 18rpx;
  height: 53rpx;
  line-height: 53rpx;
  border-radius: 18rpx;
  background: #eaf3ed;
  color: #246447;
  font-size: 21rpx;
}

.section {
  margin: 0 24rpx 16rpx;
  padding: 27rpx 25rpx;
  border: 1rpx solid #e3e9e4;
  border-radius: 26rpx;
  background: #fff;
}

.section-label {
  margin-bottom: 22rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.optional {
  margin-left: 8rpx;
  color: #a2a299;
  font-size: 21rpx;
  font-weight: 400;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.category-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin: 0;
  padding: 0 12rpx;
  height: 76rpx;
  border: 2rpx solid transparent;
  border-radius: 21rpx;
  background: #f1f4f2;
  color: #59655d;
  font-size: 24rpx;
}

.category-option.active {
  border-color: #246447;
  background: #eaf3ed;
  color: #1f5a3f;
  font-weight: 650;
}

.category-emoji {
  width: 31rpx;
  height: 31rpx;
}

.lifecycle-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.lifecycle-option {
  display: flex;
  align-items: center;
  gap: 13rpx;
  box-sizing: border-box;
  margin: 0;
  padding: 18rpx;
  height: 104rpx;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: #f1f4f2;
  color: #59655d;
  text-align: left;
}

.lifecycle-option.want.active {
  border-color: #246447;
  background: #eaf3ed;
  color: #1f5a3f;
}

.lifecycle-option.visited.active {
  border-color: #246447;
  background: #eaf3ed;
  color: #1f5a3f;
}

.lifecycle-icon {
  flex: none;
  font-size: 32rpx;
}

.lifecycle-copy {
  min-width: 0;
}

.lifecycle-title {
  font-size: 25rpx;
  line-height: 1.2;
  font-weight: 700;
}

.lifecycle-description {
  margin-top: 5rpx;
  color: #8b8c83;
  font-size: 18rpx;
  line-height: 1.2;
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 19rpx;
  border-radius: 19rpx;
  background: #f1f4f2;
  color: #202923;
  font-size: 25rpx;
  line-height: 1.55;
}

.word-count {
  margin-top: 10rpx;
  color: #a0a198;
  text-align: right;
  font-size: 19rpx;
}

.save-area {
  margin: 34rpx 24rpx 0;
}

.save-button {
  width: 100%;
  height: 91rpx;
  line-height: 91rpx;
  border-radius: 25rpx;
  background: #246447;
  color: #fff;
  font-size: 29rpx;
  font-weight: 750;
  box-shadow: 0 10rpx 30rpx rgba(20, 68, 43, 0.20);
}

.delete-button {
  margin-top: 20rpx;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #a25349;
  font-size: 24rpx;
}
