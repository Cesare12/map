.editor-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f2f2f7;
}

.place-hero {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 24rpx 24rpx 22rpx;
  padding: 27rpx 25rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-radius: 26rpx;
  background: #fff;
  color: #1c1c1e;
}

.hero-pin {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
}

.hero-pin image {
  width: 40rpx;
  height: 40rpx;
}

.category-symbol-text {
  min-width: 31rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.hero-pin .category-symbol-text {
  font-size: 29rpx;
}

.hero-content {
  flex: 1;
  min-width: 0;
}

.name-input {
  height: 58rpx;
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 600;
}

.name-input::placeholder {
  color: #aeaeb2;
}

.address {
  margin-top: 6rpx;
  color: #8e8e93;
  font-size: 22rpx;
  line-height: 1.5;
}

.reselect-button {
  flex: none;
  margin: 2rpx 0 0;
  padding: 0 18rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 18rpx;
  background: transparent;
  color: #007aff;
  font-size: 21rpx;
}

.section {
  margin: 0 24rpx 16rpx;
  padding: 27rpx 25rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.12);
  border-radius: 26rpx;
  background: #fff;
}

.section-label {
  margin-bottom: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.optional {
  margin-left: 8rpx;
  color: #8e8e93;
  font-size: 21rpx;
  font-weight: 400;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 13rpx;
}

.category-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  margin: 0;
  padding: 0 12rpx;
  position: relative;
  height: 88rpx;
  border: 2rpx solid transparent;
  border-radius: 21rpx;
  background: #f2f2f7;
  color: #3c3c43;
  font-size: 24rpx;
}

.category-option.active {
  color: #1c1c1e;
  font-weight: 600;
}

.category-emoji {
  width: 31rpx;
  height: 31rpx;
}

.category-check {
  position: absolute;
  top: 5rpx;
  right: 8rpx;
  color: #007aff;
  font-size: 20rpx;
  font-weight: 700;
}

.lifecycle-control {
  display: flex;
  align-items: center;
  height: 72rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: #e9e9eb;
}

.lifecycle-option {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 64rpx;
  border-radius: 15rpx;
  background: transparent;
  color: #6c6c70;
  font-size: 24rpx;
  line-height: 64rpx;
  text-align: center;
}

.lifecycle-option.active {
  background: #fff;
  color: #1c1c1e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.lifecycle-help {
  display: flex;
  align-items: center;
  gap: 9rpx;
  margin-top: 17rpx;
  color: #6c6c70;
  font-size: 21rpx;
}

.lifecycle-state-icon {
  color: #007aff;
  font-size: 24rpx;
  font-weight: 600;
}

.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 19rpx;
  border-radius: 19rpx;
  background: #f2f2f7;
  color: #1c1c1e;
  font-size: 25rpx;
  line-height: 1.55;
}

.word-count {
  margin-top: 10rpx;
  color: #8e8e93;
  text-align: right;
  font-size: 19rpx;
}

.save-area {
  margin: 34rpx 24rpx 0;
}

.save-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 25rpx;
  background: #007aff;
  color: #fff;
  font-size: 29rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 18rpx rgba(0, 122, 255, 0.20);
}

.save-button[disabled] {
  background: #c7c7cc;
  color: #fff;
  box-shadow: none;
}

.delete-button {
  margin-top: 20rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #d70015;
  font-size: 24rpx;
}
