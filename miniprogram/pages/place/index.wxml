<view class="editor-page">
  <view class="place-hero">
    <view class="hero-pin" style="background: {{selectedCategorySoftColor}}">
      <image src="{{selectedCategoryIconPath}}" mode="aspectFit" />
    </view>
    <view class="hero-content">
      <input
        class="name-input"
        value="{{name}}"
        maxlength="40"
        placeholder="地点名称"
        bindinput="onNameInput"
      />
      <view class="address">{{address || (latitude && longitude ? '地图上的自选位置' : '尚未选择地点')}}</view>
    </view>
    <button class="reselect-button" bindtap="reselectLocation">重新选择</button>
  </view>

  <view class="section">
    <view class="section-label">放进哪个分类</view>
    <view class="category-grid">
      <button
        wx:for="{{categoryOptions}}"
        wx:key="id"
        class="category-option {{item.active ? 'active' : ''}}"
        style="{{item.style}}"
        data-id="{{item.id}}"
        bindtap="selectCategory"
      >
        <image class="category-emoji" src="{{item.iconPath}}" mode="aspectFit" />
        <text>{{item.name}}</text>
        <text class="category-check" wx:if="{{item.active}}">✓</text>
      </button>
    </view>
  </view>

  <view class="section">
    <view class="section-label">状态</view>
    <view class="lifecycle-control">
      <button
        wx:for="{{lifecycleOptions}}"
        wx:key="id"
        class="lifecycle-option {{item.active ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="selectLifecycle"
      >{{item.title}}</button>
    </view>
    <view class="lifecycle-help">
      <text class="lifecycle-state-icon">{{lifecycleStatus == 'want' ? '○' : '✓'}}</text>
      <text>{{lifecycleStatus == 'want' ? '尚未到访，保留在种草列表' : '已经到访，记录一次拔草'}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-label">地点笔记 <text class="optional">选填</text></view>
    <textarea
      class="note-input"
      value="{{note}}"
      maxlength="300"
      placeholder="想去的理由、推荐内容，或者其他值得记住的事……"
      auto-height
      bindinput="onNoteInput"
    ></textarea>
    <view class="word-count">{{note.length}} / 300</view>
  </view>

  <view class="save-area">
    <button class="save-button" bindtap="savePlace" disabled="{{!name || !latitude || !longitude}}">{{editing ? '完成' : '添加到地图'}}</button>
    <button class="delete-button" wx:if="{{editing}}" bindtap="deletePlace">删除这个地点</button>
  </view>
</view>
